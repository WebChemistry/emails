{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
	{% set sent_count = collector.sentCount %}
	{% set operation_count = collector.operations|length %}

	{% if sent_count > 0 or operation_count > 0 %}
		{% set icon %}
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="3" y="5" width="18" height="14" rx="2"></rect>
				<path d="m3 7 9 6 9-6"></path>
			</svg>
			<span class="sf-toolbar-value">{{ sent_count }}</span>
		{% endset %}

		{% set text %}
			<div class="sf-toolbar-info-piece">
				<b>Recipients</b>
				<span class="sf-toolbar-status">{{ sent_count }}</span>
			</div>
			<div class="sf-toolbar-info-piece">
				<b>Messages</b>
				<span>{{ collector.sentEmails|length }}</span>
			</div>
			<div class="sf-toolbar-info-piece">
				<b>Operations</b>
				<span>{{ operation_count }}</span>
			</div>
		{% endset %}

		{{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url }) }}
	{% endif %}
{% endblock %}

{% block menu %}
	<span class="label {{ collector.sentEmails is empty and collector.operations is empty ? 'disabled' }}">
		<span class="icon">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="3" y="5" width="18" height="14" rx="2"></rect>
				<path d="m3 7 9 6 9-6"></path>
			</svg>
		</span>
		<strong>Emails</strong>
		{% if collector.sentCount > 0 %}
			<span class="count">
				<span>{{ collector.sentCount }}</span>
			</span>
		{% endif %}
	</span>
{% endblock %}

{% block panel %}
	<h2>Sent emails</h2>

	{% if collector.sentEmails is empty %}
		<div class="empty">
			<p>No emails were sent during this request.</p>
		</div>
	{% else %}
		{% for email in collector.sentEmails %}
			<h3>{{ email.subject ?? '(no subject)' }}</h3>
			<table>
				<tbody>
					<tr>
						<th>Recipients</th>
						<td>{{ email.recipients|join(', ') }}</td>
					</tr>
					<tr>
						<th>Sender</th>
						<td>{{ email.sender ?? '(none)' }}</td>
					</tr>
					<tr>
						<th>Section</th>
						<td>{{ email.section ?? '(none)' }}</td>
					</tr>
					<tr>
						<th>Category</th>
						<td>{{ email.category ?? '(none)' }}</td>
					</tr>
					{% if email.body is not null %}
						<tr>
							<th>Body</th>
							<td><pre style="white-space: pre-wrap; max-height: 400px; overflow: auto;">{{ email.body }}</pre></td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		{% endfor %}
	{% endif %}

	<h2>Operations</h2>

	{% if collector.operations is empty %}
		<div class="empty">
			<p>No operations were performed during this request.</p>
		</div>
	{% else %}
		<table>
			<thead>
				<tr>
					<th>Type</th>
					<th>Accounts</th>
					<th>Groups</th>
				</tr>
			</thead>
			<tbody>
				{% for operation in collector.operations %}
					<tr>
						<td>{{ operation.type }}</td>
						<td>{{ operation.accounts|join(', ') }}</td>
						<td>{{ operation.groups|join(', ') ?: '(none)' }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endif %}
{% endblock %}
